<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    tools:deviceIds="wear">

  <androidx.core.widget.NestedScrollView
      android:id="@+id/calculator_scroll"
      android:layout_width="match_parent"
      android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

      <androidx.wear.widget.BoxInsetLayout
          android:id="@+id/calculator_page"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:padding="@dimen/box_inset_layout_padding">

        <FrameLayout
            android:id="@+id/main_text_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:padding="@dimen/inner_frame_layout_padding"
            app:layout_boxedEdges="all">

          <TextView
              android:id="@+id/txt_input"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:gravity="center"
              android:textColor="?attr/colorOnSurface"
              android:textSize="20sp" />
          <TextView
              android:id="@+id/txt_result"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:gravity="center"
              android:textColor="?attr/colorOnSurface"
              android:textSize="20sp" />
        </FrameLayout>

        <RelativeLayout
            android:id="@+id/digits_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <RelativeLayout
            android:id="@+id/center_menu_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:clickable="false">

          <!-- Fills up around backspace while the finger rests on it, until clear-all arms. -->
          <dev.starpad.calculatorforwear.menu.HoldProgressView
              android:id="@+id/hold_progress"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:importantForAccessibility="no" />

          <!--
            The wrapper stays: it is measured as wrap_content around the glyphs, which are placed
            relative to its edges, so flattening it into the parent would move them. Left/right
            margins are deliberate too - the drag angles the calculator matches are fixed, so the
            menu must not mirror in RTL locales.
          -->
          <RelativeLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_centerInParent="true"
              tools:ignore="RtlHardcoded,UselessParent">

            <TextView
                android:id="@+id/txt_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="120dp"
                android:alpha="0.7"
                android:fontFamily="sans-serif-medium"
                android:text="@string/operator_add"
                android:textColor="?attr/colorOnSurface"
                android:textSize="28sp" />
            <TextView
                android:id="@+id/txt_subtract"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="120dp"
                android:alpha="0.7"
                android:fontFamily="sans-serif-medium"
                android:text="@string/operator_subtract"
                android:textColor="?attr/colorOnSurface"
                android:textSize="28sp" />
            <TextView
                android:id="@+id/txt_multiply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="120dp"
                android:alpha="0.7"
                android:fontFamily="sans-serif-medium"
                android:text="@string/operator_multiply"
                android:textColor="?attr/colorOnSurface"
                android:textSize="28sp" />
            <TextView
                android:id="@+id/txt_divide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginRight="120dp"
                android:alpha="0.7"
                android:fontFamily="sans-serif-medium"
                android:text="@string/operator_divide"
                android:textColor="?attr/colorOnSurface"
                android:textSize="28sp" />
            <TextView
                android:id="@+id/txt_equal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:alpha="0.7"
                android:fontFamily="sans-serif-medium"
                android:text="@string/operator_equals"
                android:textColor="?attr/colorOnSurface"
                android:textSize="28sp" />
            <ImageView
                android:id="@+id/img_backspace"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignLeft="@id/txt_divide"
                android:layout_alignTop="@id/txt_subtract"
                android:layout_marginLeft="18dp"
                android:layout_marginTop="32dp"
                android:alpha="0.7"
                android:contentDescription="@null"
                android:src="@drawable/ic_baseline_backspace_24"
                app:tint="?attr/colorOnSurface" />
            <TextView
                android:id="@+id/txt_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/txt_add"
                android:layout_alignRight="@id/txt_multiply"
                android:layout_marginBottom="22dp"
                android:layout_marginRight="22dp"
                android:alpha="0.7"
                android:fontFamily="sans-serif-medium"
                android:text="@string/operator_decimal"
                android:textColor="?attr/colorOnSurface"
                android:textSize="28sp" />
            <TextView
                android:id="@+id/txt_pow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignRight="@id/txt_multiply"
                android:layout_alignTop="@id/txt_subtract"
                android:layout_marginRight="20dp"
                android:layout_marginTop="26dp"
                android:alpha="0.7"
                android:fontFamily="sans-serif-medium"
                android:text="@string/operator_power"
                android:textColor="?attr/colorOnSurface"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/txt_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/txt_add"
                android:layout_alignLeft="@id/txt_divide"
                android:layout_marginBottom="18dp"
                android:layout_marginLeft="18dp"
                android:alpha="0.7"
                android:fontFamily="sans-serif-medium"
                android:text="@string/operator_percent"
                android:textColor="?attr/colorOnSurface"
                android:textSize="24sp" />
          </RelativeLayout>

          <!--
            Names the hovered action on the top bezel: the glyphs are terse and the finger covers
            them mid-drag. It lives inside the menu so it fades in and out with it, and sits at
            the top because the finger enters the gesture from the bottom of the watch.
          -->
          <androidx.wear.widget.CurvedTextView
              android:id="@+id/choice_label"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:ellipsize="end"
              android:fontFamily="sans-serif-medium"
              android:importantForAccessibility="no"
              android:padding="8dp"
              android:textColor="?attr/colorOnSurface"
              android:textSize="13sp"
              app:anchorAngleDegrees="0"
              app:anchorPosition="center"
              app:maxSweepDegrees="150" />
        </RelativeLayout>
      </androidx.wear.widget.BoxInsetLayout>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_horizontal"
          android:orientation="vertical"
          android:padding="@dimen/inner_frame_layout_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="10dp"
            android:text="@string/history_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/history_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_empty"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <LinearLayout
            android:id="@+id/history_entries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layout_marginTop="12dp"
            android:text="@string/settings_title" />
      </LinearLayout>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>

  <FrameLayout
      android:id="@+id/tutorial_container"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:clickable="true"
      android:focusable="true"
      android:visibility="gone" />
</FrameLayout>
